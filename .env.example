# Домен без https:// — Caddy получит на него сертификат автоматически
DOMAIN=reportmed.ru

# База данных
# PGHOST и PGPORT задаются в docker-compose.yml, здесь их указывать не нужно
PGUSER=medapp
PGDATABASE=medapp
PGPASSWORD=

# Секреты приложения
JWT_SECRET=
ADMIN_SECRET=

# Значения генерировать так:
#   openssl rand -hex 32
